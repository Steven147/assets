# Map Pipeline — 4 stages: source / grid / resolved / html
# Run `just` to list all commands.

PORT := "8765"
PY := "uv run python3"

default:
    @just --list

# ============================================================
# Stage 1: source
# ============================================================

# local:  read input/<name>_decl.json, write output/<name>/<name>_decl.json
s1-local name:
    {{PY}} stage1_source.py local {{name}}

# osm:    pull Overpass data, rasterize, write decl to output/<city>_<size>km/
s1-osm city size_km name="":
    @if [ -z "{{name}}" ]; then \
        {{PY}} stage1_source.py osm --city {{city}} --size-km {{size_km}}; \
    else \
        {{PY}} stage1_source.py osm --city {{city}} --size-km {{size_km}} --name {{name}}; \
    fi

# ============================================================
# Stage 2-4
# ============================================================

s2 name:
    {{PY}} stage2_grid.py {{name}}

s3 name:
    {{PY}} stage3_resolved.py {{name}}

s4 name:
    {{PY}} stage4_html.py {{name}}

# ============================================================
# One-shot: full pipeline
# ============================================================

# build: stage1=local, then 2/3/4
build name: (s1-local name) (s2 name) (s3 name) (s4 name)

# build-osm: stage1=osm, then 2/3/4
build-osm city size_km:
    @NAME="{{city}}_{{size_km}}km"; \
    just s1-osm {{city}} {{size_km}} "$NAME"; \
    just s2 "$NAME"; \
    just s3 "$NAME"; \
    just s4 "$NAME"

# ============================================================
# View: serve + open
# ============================================================

serve:
    @{{PY}} -m http.server {{PORT}} --bind 127.0.0.1

view name: (view-auto name)
view-auto name:
    @# Pick world_viewer.html vs <name>_viewer.html based on kind in grid.json
    @if [ -f output/{{name}}/{{name}}_grid.json ] && \
         {{PY}} -c "import json,sys; d=json.load(open('output/{{name}}/{{name}}_grid.json')); sys.exit(0 if d.get('kind')=='world' else 1)"; then \
        export HTML="output/{{name}}/world_viewer.html"; \
    else \
        export HTML="output/{{name}}/{{name}}_viewer.html"; \
    fi && \
    curl -sf -o /dev/null http://127.0.0.1:{{PORT}}/ 2>/dev/null || \
        ({{PY}} -m http.server {{PORT}} --bind 127.0.0.1 >/dev/null 2>&1 &) && \
    open "http://127.0.0.1:{{PORT}}/$HTML"

# ============================================================
# Cleanup
# ============================================================

clean:
    @trash output 2>/dev/null || rm -rf output

# ============================================================
# Tests
# ============================================================

test:
    {{PY}} -m pytest tests/ -v

smoke:
    @cp tests/fixtures/smoke_test_decl.json input/smoke_test_decl.json
    @just build smoke_test
    @just view smoke_test
